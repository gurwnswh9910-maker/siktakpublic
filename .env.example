# 로컬 실행용 예시. `npm run setup`이 무작위 비밀값을 채운 .env를 만든다.
DATABASE_URL=postgresql://siktak:siktak_dev_local@localhost:5432/siktak
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# 시연 모드: 테스트 계정·합성 참가자·모의 결제·가상 식당·시연 시간 이동 버튼
DEMO_MODE=true
DEMO_PASSWORD=replace-with-a-demo-account-password
MATCH_EVALUATOR=decisions-v1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com
# worker: 같은 머신의 작업 worker가 예약 작업을 처리한다(기본).
# scheduler: 외부 Cron이 POST /api/jobs/run을 호출한다(SCHEDULER_SECRET 32자 이상 필요).
AUTOMATION_MODE=worker
SCHEDULER_SECRET=
# start-web.mjs가 웹과 worker를 한 컨테이너에서 함께 띄운다(Render 무료 배포용).
SIKTAK_EMBEDDED_WORKER=false
DEMO_SEED_ON_START=false
