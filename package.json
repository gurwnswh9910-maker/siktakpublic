{
  "name": "siktak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build-runtime.mjs && next build && node scripts/verify-matching-runtime.mjs",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --env-file=.env --import tsx src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup-env.mjs",
    "start:web": "node --env-file=.env scripts/start-web.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.9",
    "highs": "1.15.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.1",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
